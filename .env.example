# Variáveis somente do servidor. Nunca use prefixo VITE_ nestas credenciais.
RESEND_API_KEY=
# Endereço remetente de domínio verificado no Resend (não o e-mail do visitante).
CONTACT_FROM=
# Domínio oficial quando confirmado; ativa também canonical/sitemap do site.
SITE_URL=
# Origens locais/preview adicionais, separadas por vírgula. Não aceita curinga.
CONTACT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
