{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "functions": { "api/contact.ts": { "maxDuration": 15 } },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
